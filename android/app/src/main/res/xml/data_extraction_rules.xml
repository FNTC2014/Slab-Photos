<?xml version="1.0" encoding="utf-8"?>
<!-- The eBay sign-in stays on this phone: it's never copied to a backup or a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ebay.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ebay.xml" />
    </device-transfer>
</data-extraction-rules>
